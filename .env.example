ENV=development
PORT=8080
# Dev: guna Postgres lokal (Homebrew) — createdb marc dulu, guna username OS anda
# Prod: Railway akan bekalkan DATABASE_URL sendiri (Postgres plugin)
DATABASE_URL=postgres://localhost:5432/marc?sslmode=disable
# Generate contoh: openssl rand -base64 48
JWT_SECRET=
# Optional — kalau kosong, push notification jadi no-op senyap
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
# Optional — kalau kosong, email verification tak dihantar (token
# tetap dijana + di-log ke server). Daftar API key di resend.com.
RESEND_API_KEY=
# Format "Nama <alamat@domain>" atau alamat je. Domain kena verified
# kat Resend dulu (dev boleh guna onboarding@resend.dev untuk test).
EMAIL_FROM=
# URL awam server ni — dipakai untuk bina link dalam email verification
# (cth: https://api.marc-app.com). Default localhost untuk dev.
PUBLIC_BASE_URL=http://localhost:8080
# Optional — page landing branded untuk link email verification
# (portfolio-astro Stage 8). Kalau kosong, fallback ke Go punya HTML
# page sendiri (PUBLIC_BASE_URL + /auth/verify-email/confirm).
EMAIL_VERIFY_URL=https://hafizbahtiar.com/verify-email
