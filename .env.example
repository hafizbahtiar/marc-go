ENV=development
PORT=8080
# Dev: guna Postgres lokal (Homebrew) — createdb marc dulu, guna username OS anda
# Prod: Railway akan bekalkan DATABASE_URL sendiri (Postgres plugin)
DATABASE_URL=postgres://localhost:5432/marc?sslmode=disable
# Generate contoh: openssl rand -base64 48
JWT_SECRET=
# Optional — kalau kosong, push notification jadi no-op senyap
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
# Optional — kalau kosong, email verification tak dihantar (token
# tetap dijana + di-log ke server). Daftar API key di resend.com.
RESEND_API_KEY=
# Format "Nama <alamat@domain>" atau alamat je. Domain kena verified
# kat Resend dulu (dev boleh guna onboarding@resend.dev untuk test).
EMAIL_FROM=
# URL awam server ni — dipakai untuk bina link dalam email verification
# (cth: https://api.marc-app.com). Default localhost untuk dev.
PUBLIC_BASE_URL=http://localhost:8080
# Optional — page landing branded untuk link email verification
# (portfolio-astro Stage 8). Kalau kosong, fallback ke Go punya HTML
# page sendiri (PUBLIC_BASE_URL + /auth/verify-email/confirm).
EMAIL_VERIFY_URL=https://hafizbahtiar.com/verify-email
# Optional — kalau kosong, upload gambar post (Stage 10) disabled (503
# graceful, bukan crash). Cloudflare dashboard -> R2 -> Manage API tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Domain awam bucket (r2.dev subdomain atau custom domain yang dah wire)
R2_PUBLIC_URL=
# Optional — kalau kosong, donation checkout (Stage 12, Stripe) disabled
# (503 graceful, bukan crash). Guna akaun Stripe BERASINGAN drpd
# ToyyibPay (yuran ahli) — ni khas untuk "Donate to us".
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Stripe dashboard -> Developers -> Webhooks -> signing secret bagi
# endpoint /webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Optional — yuran ahli (Stage 12, belum wired ke handler; lihat TODO.md
# bahagian Payment). Kosong = ToyyibPayGateway.Enabled() pulang false.
#
# BASE_URL: kosongkan untuk produksi (jatuh balik ke
# https://toyyibpay.com dalam kod). Set https://dev.toyyibpay.com untuk
# sandbox — akaun/kredential BERASINGAN drpd produksi, daftar dulu di
# situ.
#
# SECRET_KEY: dashboard ToyyibPay -> bawah kiri ("Secret Key" atau
# padanan) -> userSecretKey.
#
# CATEGORY_CODE: BUKAN wujud automatik, BUKAN sama untuk semua akaun —
# anda kena CIPTA dulu. Dashboard -> tab "Category" (menu sisi) -> "Add
# New Category" -> isi nama + penerangan -> lepas simpan, Category Code
# terpapar dalam lajur senarai kategori. Guna kategori BERASINGAN untuk
# sandbox vs produksi (dua akaun berlainan pun).
TOYYIBPAY_BASE_URL=
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
# Optional — yuran pendaftaran ahli SEKALI BAYAR, dalam SEN. Kosong =
# default RM10 (1000). PLACEHOLDER, nilai sebenar belum diputuskan
# management.
REGISTRATION_FEE_CENTS=

# Polisi simpanan (hari). Kosong = guna default. 0 = matikan sapuan itu.
# PII audit (ip_address/user_agent) diredaksi lebih awal drpd catatan audit
# itu sendiri dipadam — lihat internal/retention.
AUDIT_PII_RETENTION_DAYS=
AUDIT_RECORD_RETENTION_DAYS=
UPLOAD_TOMBSTONE_RETENTION_DAYS=
# Default 90 hari (3 bulan) — keputusan produk 2026-08-15. Log peristiwa
# bayaran merentas semua modul (donation/yuran pendaftaran/yuran aktiviti),
# termasuk payload mentah gateway — lihat internal/paymentlog.
PAYMENT_LOG_RETENTION_DAYS=

# Optional. Kosong = ciri berkaitan guna state setempat (per-instance).
# Railway: rujuk perkhidmatan Redis -> ${{Redis.REDIS_URL}}
REDIS_URL=
